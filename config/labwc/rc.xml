<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <!-- Console DE — PS5-style. All font sizes are set for 200% scaling;
       GTK apps scale via GDK_SCALE (set in the session script). -->
  <theme>
    <cornerRadius>12</cornerRadius>
    <gap>10</gap>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>22</size><slant>normal</slant><weight>bold</weight></font>
    <font place="InactiveWindow"><name>DejaVu Sans</name><size>22</size><slant>normal</slant><weight>normal</weight></font>
    <font place="MenuHeader"><name>DejaVu Sans</name><size>22</size><weight>bold</weight></font>
    <font place="MenuItem"><name>DejaVu Sans</name><size>20</size></font>
    <font place="OnScreenDisplay"><name>DejaVu Sans</name><size>28</size><weight>bold</weight></font>
  </theme>

  <keyboard>
    <!-- shell & launcher -->
    <keybind key="W-g"><action name="Execute" command="console-de-shell"/></keybind>
    <keybind key="W-S-space"><action name="Execute" command="console-de-shell --control-center"/></keybind>
    <keybind key="W-Return"><action name="Execute" command="console-de-env foot"/></keybind>

    <!-- F13: generated by cursor_hide.py at startup and after one second
         without trackpad movement. -->
    <keybind key="F13"><action name="HideCursor"/></keybind>

    <!-- window management -->
    <keybind key="W-c"><action name="Close"/></keybind>
    <keybind key="W-f"><action name="ToggleFullscreen"/></keybind>
    <keybind key="W-m"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-i"><action name="Iconify"/></keybind>
    <keybind key="W-Tab"><action name="Execute" command="console-de-shell"/></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow"/></keybind>
    <keybind key="W-C-Tab"><action name="PreviousWindowImmediate"/></keybind>

    <!-- snap / move -->
    <keybind key="W-S-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-S-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="W-S-Up"><action name="SnapToEdge" direction="up"/></keybind>
    <keybind key="W-S-Down"><action name="SnapToEdge" direction="down"/></keybind>
    <keybind key="W-A-Left"><action name="MoveToEdge" direction="left"/></keybind>
    <keybind key="W-A-Right"><action name="MoveToEdge" direction="right"/></keybind>
    <keybind key="W-A-Up"><action name="MoveToEdge" direction="up"/></keybind>
    <keybind key="W-A-Down"><action name="MoveToEdge" direction="down"/></keybind>

    <!-- workspaces -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-A-1"><action name="SendToDesktop" to="1"/></keybind>
    <keybind key="W-A-2"><action name="SendToDesktop" to="2"/></keybind>
    <keybind key="W-A-3"><action name="SendToDesktop" to="3"/></keybind>
    <keybind key="W-A-4"><action name="SendToDesktop" to="4"/></keybind>

    <!-- session -->
    <keybind key="W-e"><action name="Execute" command="console-de-power"/></keybind>
    <!-- screenshots: F7 (sent by Fn+F7 on most laptops) = full screen,
         XF86Display = the media code many Samsung/other laptops emit
         for Fn+F7; W-F7 = pick a region -->
    <keybind key="F7"><action name="Execute" command="console-de-screenshot"/></keybind>
    <keybind key="XF86Display"><action name="Execute" command="console-de-screenshot"/></keybind>
    <keybind key="W-F7"><action name="Execute" command="console-de-screenshot -s"/></keybind>
    <keybind key="Ctrl+Alt+Delete">
      <action name="Execute" command="console-de-power logout"/>
    </keybind>
    <keybind key="W-XF86Display"><action name="Execute" command="console-de-screenshot -s"/></keybind>

    <!-- volume / brightness -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +10%"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 10%-"/></keybind>
  </keyboard>

  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu"/></mousebind>
    </context>
    <context name="TitleBar">
      <mousebind button="Left" action="Press"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="A-Left" action="Press"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Press"><action name="Resize"/></mousebind>
    </context>
  </mouse>

  <focus><followMouse>no</followMouse><raiseOnFocus>yes</raiseOnFocus></focus>
  <resistance><strength>10</strength><screen_edge_strength>10</screen_edge_strength></resistance>
  <snapping><range inner="10" outer="10"/><overlay>yes</overlay></snapping>
</labwc_config>
